{
  "name": "aozora-obsidian",
  "version": "0.1.0",
  "description": "Obsidian plugin rendering pure Aozora Bunko notation, powered by a bundled aozora-wasm parser.",
  "main": "main.js",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "bun run check && node esbuild.config.mjs production && node scripts/check-wasm.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check . && tsc --noEmit",
    "check:fix": "biome check --write . && tsc --noEmit",
    "discipline": "bun run check && bun run lint:knip && bun run lint:typecov",
    "validate-manifest": "node scripts/validate-manifest.mjs",
    "test": "vitest run --coverage",
    "bench": "vitest bench --run",
    "bench:compare": "node scripts/bench-compare.mjs",
    "lint:knip": "knip --no-progress",
    "lint:typecov": "type-coverage --detail --strict --at-least 99",
    "lint:commit": "commitlint --from=HEAD~1 --to=HEAD --verbose"
  },
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.2.0"
  },
  "packageManager": "bun@1.2.23",
  "typeCoverage": {
    "atLeast": 99,
    "strict": true,
    "ignoreCatch": false,
    "ignoreFiles": [
      "tests/__mocks__/obsidian.ts"
    ]
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "aozora",
    "japanese",
    "ruby",
    "tategaki",
    "wasm"
  ],
  "author": "aozora-obsidian contributors",
  "license": "(Apache-2.0 OR MIT)",
  "repository": {
    "type": "git",
    "url": "https://github.com/P4suta/aozora-obsidian.git"
  },
  "homepage": "https://github.com/P4suta/aozora-obsidian",
  "bugs": "https://github.com/P4suta/aozora-obsidian/issues",
  "dependencies": {
    "aozora-wasm": "file:./pkg",
    "minimatch": "^10.2.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.1",
    "@commitlint/cli": "^20.5.2",
    "@commitlint/config-conventional": "^20.5.0",
    "@lezer/common": "^1.5.2",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^25.6.0",
    "@vitest/coverage-istanbul": "^4.1.5",
    "esbuild": "^0.28.0",
    "fast-check": "^4.7.0",
    "happy-dom": "^20.9.0",
    "knip": "^6.9.0",
    "obsidian": "^1.12.3",
    "type-coverage": "^2.29.7",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5",
    "zod": "^4.4.1"
  }
}
